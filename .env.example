# ---- Mode ----
# 1 = fully offline (recorded fixtures, local JSONL store). 0 = live.
MOCK=1
# use RUN_ID=demo for the long run
RUN_ID=dev
CYCLE_INTERVAL_SECONDS=120
# hard cap on INPUT tokens per LLM call
TOKEN_BUDGET=6000
MAX_CONCURRENT_SCOUTS=3
# how many inventory units to work on (scale up later)
UNITS_LIMIT=4

# ---- Chief / Auditor / Scout LLM (pluggable) ----
# openai | groq | anthropic | openrouter | liquid | mock
LLM_PROVIDER=openai
# optional override, e.g. gpt-4.1-mini / claude-sonnet-5 / openai/gpt-4.1-mini
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ---- Librarian: Liquid AI LFM2 (local via Ollama, or hosted) ----
LIQUID_BASE_URL=http://localhost:11434
LIQUID_MODEL=hf.co/LiquidAI/LFM2.5-1.2B-Instruct-GGUF
# only for Liquid's hosted OpenAI-compatible API (LIQUID_BASE_URL=https://...)
LIQUID_API_KEY=

# ---- Nimble (web data) ----
NIMBLE_API_KEY=

# ---- RawTree (state store + observability; key from https://rawtree.com) ----
RAWTREE_API_KEY=
RAWTREE_API_URL=https://api.rawtree.com

# ---- Black Forest Labs (stretch) ----
BFL_API_KEY=
